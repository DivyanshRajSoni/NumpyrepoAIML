    "#Normalization..\n",
    "import numpy as np\n",
    "arr = np.array([[1,2],[3,4]])\n",
    "mean = np.mean(arr)\n",
    "std_dev = np.std(arr)\n",
    "#print(np.mean(arr))\n",
    "#print(np.std(arr))\n",
    "normalized_arr = (arr-mean)/std_dev\n",
    "print(normalized_arr)\n"
   ]
